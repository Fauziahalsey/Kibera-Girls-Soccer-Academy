# Paystack public key for frontend card donations (Visa, MasterCard)
# Get keys at https://dashboard.paystack.com/
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Flutterwave public key for frontend checkout
# Get keys at https://dashboard.flutterwave.com/
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxx

# Backend API URL used by the frontend
VITE_API_BASE_URL=http://localhost:3000
