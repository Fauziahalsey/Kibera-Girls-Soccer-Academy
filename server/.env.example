PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:3000
API_TIMEOUT=30000

# Pesapal (card donations) — https://developer.pesapal.com/
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=your-consumer-key
PESAPAL_CONSUMER_SECRET=your-consumer-secret
# Register IPN once via POST /api/donations/pesapal/register-ipn, then save the returned ipn_id:
PESAPAL_IPN_ID=your-ipn-id-guid
PESAPAL_IPN_URL=http://localhost:3000/api/donations/pesapal/ipn
