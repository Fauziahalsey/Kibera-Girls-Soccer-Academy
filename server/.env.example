PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:3000
API_TIMEOUT=30000

# Pesapal — get keys at https://developer.pesapal.com/
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=your-consumer-key
PESAPAL_CONSUMER_SECRET=your-consumer-secret
# Optional: IPN is auto-registered on first payment if not set
PESAPAL_IPN_ID=
PESAPAL_IPN_URL=https://www.kiberagirlssocceracademy.co.ke/api/donations/pesapal/ipn
